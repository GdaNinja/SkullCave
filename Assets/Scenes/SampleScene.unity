  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 621ca204bc460714f9a8e70e1502680e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  txtNpc: {fileID: 557079849}
  dialogueLines:
  - '???: ACONTECEU DE NOVO... ACONTECEU DE NOVO!'
  - '???: Almas como a minha vagam por estas galerias... Somos os ecos de um erro
    que jamais deveria se repetir.'
  - "???: Carrego o fardo de ter iniciado tudo... Mas foram m\xE3os curiosas que
    quebraram o selo... outra vez."
  - "???: A arte... ah, a arte pode ser de um assombro sublime, mas apenas quando
    sua hist\xF3ria \xE9 contada na ordem correta."
  - "???: Este lugar, por\xE9m... n\xE3o \xE9 arte. Aqui, n\xE3o h\xE1 caminhos.
    N\xE3o h\xE1 interpreta\xE7\xF5es. S\xF3 a necrom\xE2ncia... e o fim que ela
    se recusa a aceitar.\r\n"
  dialoguePanel: {fileID: 434541359}
  dialogueTxt: {fileID: 596837137}
